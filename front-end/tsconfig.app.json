{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Configs is a module of this application whose source sits in the sibling
       `configs-front-end` folder, so that it is all in one place until it is
       ready to be merged in. These two paths mirror the aliases in
       vite.config.ts and must stay in step with them. No `baseUrl`: it is
       deprecated in TypeScript 6, and these are resolved relative to this file
       without it. */
    "paths": {
      "@cs/*": ["./src/*"],
      "@configs/*": ["../configs-front-end/src/*"],
      "@interp/*": ["../interpreter-front-end/src/*"],

      /* A module folder is outside this one, so walking up from a file in it
         never reaches this `node_modules`. Three bare specifiers have to be
         pointed back here by hand: the one the compiler inserts itself for JSX,
         and `react`/`react-dom` for the modules that call hooks.

         Each points at the **types**, not the package. Mapping `react` to
         `./node_modules/react` resolves it to the JavaScript, which ships no
         declarations, and every file in the project loses its types at once —
         that failure is why these are spelled out rather than globbed. */
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src", "../configs-front-end/src", "../interpreter-front-end/src"]
}
