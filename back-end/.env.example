# Copy to .env and edit, or export these directly. Every one has a working
# default, so the API runs with none of them set.

# The project id the frontend opens into. Must match PROJECT_ID in
# front-end/src/config.ts, or every screen renders a 404.
CLEVERPRO_DEMO_PROJECT_ID=proj_1

# Set to 0 to start with an empty store instead of the Orchid Lab demo data.
CLEVERPRO_SEED=1

# Comma-separated browser origins allowed to call the API directly. The dev
# setup proxies /api through Vite and so needs none of this; it matters when a
# deployed client is served from another origin.
CLEVERPRO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Attachment ceilings. Every version's full content is kept in memory, so an
# unbounded push is an unbounded allocation. These mirror the limits the
# browser applies in front-end/src/lib/folder.ts.
CLEVERPRO_MAX_TREE_FILES=2000
CLEVERPRO_MAX_FILE_CHARS=262144
CLEVERPRO_MAX_TOTAL_CHARS=8388608
CLEVERPRO_MAX_UPLOAD_BYTES=2097152
